# ── Persistence ──────────────────────────────────────────────────────
# Unset → demo mode: in-container node:sqlite with seed data (resets on
# redeploy). Set → Postgres via pooled `pg`; migrations/*.sql apply at boot.
#DATABASE_URL=postgres://roofline:secret@db.internal:5432/roofline

# TLS to Postgres: disable | no-verify | verify.
# Default: verify the server certificate against the CA when NODE_ENV=production
# (rejectUnauthorized), off otherwise. Use no-verify only as a temporary escape
# hatch while a CA bundle is being wired up.
#DATABASE_SSL=verify
#DATABASE_POOL_MAX=10

# Demo sqlite file location (demo mode only).
#ROOFLINE_SQLITE_PATH=data/roofline.db

# ── Auth ─────────────────────────────────────────────────────────────
# amos | demo. Default: amos when DATABASE_URL is set, demo otherwise.
#AUTH_MODE=amos

# This app's id on the platform — required `aud` of X-Amos-Identity tokens.
# Token verification fails closed while unset.
#AMOS_APP_AUTH_APP_ID=

# Overrides for the platform IdP endpoints.
#AMOS_APP_AUTH_JWKS_URL=https://app.amoslabs.com/.well-known/amos-app-auth/jwks.json
#AMOS_APP_AUTH_LOGIN_URL=

# HMAC key for the session cookie. REQUIRED (and must be a strong, unique
# random value — 32+ bytes) whenever NODE_ENV=production, AUTH_MODE=amos, or
# DATABASE_URL is set: the app refuses to boot otherwise, because the built-in
# demo fallback is public and would make every session forgeable. Only pure
# local sqlite demo may omit it.
#ROOFLINE_SESSION_SECRET=

# Expected issuer of X-Amos-Identity tokens. Defaults to the JWKS URL origin.
#AMOS_APP_AUTH_ISS=https://app.amoslabs.com
